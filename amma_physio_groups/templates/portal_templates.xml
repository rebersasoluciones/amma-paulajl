<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ==================== TARJETA EN /my/home ==================== -->
    <template id="portal_my_home_physio" name="Portal: Fisioterapia"
              inherit_id="portal.portal_my_home" priority="30">
        <xpath expr="//div[@id='portal_common_category']" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="icon" t-value="'/amma_physio_groups/static/description/icon.png'"/>
                <t t-set="title">Mis clases</t>
                <t t-set="text">Consulta tu grupo y reserva o anula tus clases</t>
                <t t-set="url" t-value="'/my/physio'"/>
                <t t-set="config_card" t-value="True"/>
            </t>
        </xpath>
    </template>

    <!-- ==================== PÁGINA PRINCIPAL DEL PACIENTE ==================== -->
    <template id="portal_physio_home" name="Portal: Mis clases de fisioterapia">
        <t t-call="portal.portal_layout">
            <t t-set="page_name" t-value="'physio'"/>

            <div class="container">
                <ol class="breadcrumb mt-3 mb-0">
                    <li class="breadcrumb-item">
                        <a href="/my/home" aria-label="Inicio" title="Inicio"><i class="fa fa-home"/></a>
                    </li>
                    <li class="breadcrumb-item active">Mis clases</li>
                </ol>
                <!-- Avisos -->
                <div t-if="request.params.get('booking_ok')" class="alert alert-success mt-3" role="alert">
                    <i class="fa fa-check-circle me-1"/> Te has apuntado a la clase correctamente.
                </div>
                <div t-if="request.params.get('cancel_ok')" class="alert alert-info mt-3" role="alert">
                    <i class="fa fa-info-circle me-1"/> Has anulado tu reserva.
                </div>
                <div t-if="request.params.get('booking_error')" class="alert alert-danger mt-3" role="alert">
                    <i class="fa fa-exclamation-triangle me-1"/> No se ha podido completar la operación
                    (la clase puede estar completa, ya empezada o no disponible).
                </div>
                <div t-if="request.params.get('cutoff_error')" class="alert alert-warning mt-3" role="alert">
                    <i class="fa fa-clock-o me-1"/> Debes gestionar los cambios con suficiente antelación
                    (según la norma del grupo). Ya no es posible modificar esta clase.
                </div>
                <div t-if="request.params.get('limit_error')" class="alert alert-warning mt-3" role="alert">
                    <i class="fa fa-exclamation-circle me-1"/> Has alcanzado el número máximo de clases
                    de este mes.
                </div>

                <div class="d-flex justify-content-between align-items-center mt-4 mb-3 flex-wrap gap-2">
                    <h3 class="m-0">Mis clases de fisioterapia</h3>
                    <a href="/my/physio/semana" class="btn btn-outline-primary btn-sm">
                        <i class="fa fa-calendar me-1"/> Vista semanal
                    </a>
                </div>

                <!-- SIN SUSCRIPCIÓN -->
                <div t-if="not memberships" class="alert alert-warning" role="alert">
                    Todavía no tienes una suscripción activa. Ponte en contacto con la clínica.
                </div>

                <!-- MIS GRUPOS -->
                <div t-if="memberships" class="row g-3 mb-4">
                    <t t-foreach="memberships" t-as="membership">
                        <div class="col-md-6">
                            <div class="card h-100 shadow-sm">
                                <div class="card-body">
                                    <h5 class="card-title">
                                        <i class="fa fa-users me-1 text-primary"/>
                                        <span t-field="membership.group_id.name"/>
                                    </h5>
                                    <p class="card-text text-muted mb-2">
                                        Cuota mensual:
                                        <strong t-field="membership.price"
                                                t-options='{"widget": "monetary", "display_currency": membership.currency_id}'/>
                                    </p>
                                    <div t-if="membership.group_id.schedule_line_ids" class="small text-muted">
                                        <div class="fw-bold">Horario habitual:</div>
                                        <t t-foreach="membership.group_id.schedule_line_ids" t-as="slot">
                                            <span class="badge text-bg-light me-1 mb-1" t-esc="slot.display_name"/>
                                        </t>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </div>

                <!-- PAGOS PENDIENTES -->
                <div t-if="open_invoices" class="card mb-4 border-warning">
                    <div class="card-header bg-warning-subtle">
                        <i class="fa fa-credit-card me-1"/> Pagos pendientes
                    </div>
                    <div class="card-body p-0">
                        <table class="table mb-0 align-middle">
                            <tbody>
                                <t t-foreach="open_invoices" t-as="invoice">
                                    <tr>
                                        <td><span t-field="invoice.name"/></td>
                                        <td><span t-field="invoice.invoice_date"/></td>
                                        <td class="text-end">
                                            <strong t-field="invoice.amount_residual"
                                                    t-options='{"widget": "monetary", "display_currency": invoice.currency_id}'/>
                                        </td>
                                        <td class="text-end">
                                            <a t-att-href="invoice.get_portal_url(anchor='portal_pay')"
                                               class="btn btn-sm btn-primary">
                                                <i class="fa fa-credit-card me-1"/> Pagar
                                            </a>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- MIS PRÓXIMAS CLASES -->
                <h4 class="mt-4 mb-3"><i class="fa fa-calendar-check-o me-1"/> Mis próximas clases</h4>
                <p class="text-muted small">
                    Tienes tu plaza reservada automáticamente en tu grupo. Si un día no
                    puedes asistir, anula tu asistencia con antelación para que otro paciente
                    pueda ocuparla, y podrás apuntarte a otra clase disponible.
                </p>
                <div t-if="not bookings" class="text-muted mb-4">No tienes clases reservadas.</div>
                <div t-if="bookings" class="card mb-4">
                    <div class="card-body p-0">
                        <table class="table mb-0 align-middle">
                            <thead>
                                <tr>
                                    <th>Fecha y hora</th>
                                    <th>Grupo</th>
                                    <th class="text-end">Acción</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="bookings" t-as="booking">
                                    <tr>
                                        <td><span t-field="booking.session_start"/></td>
                                        <td>
                                            <span t-field="booking.group_id.name"/>
                                            <span t-if="booking.is_cross_booking"
                                                  class="badge text-bg-info ms-1">otro grupo</span>
                                        </td>
                                        <td class="text-end">
                                            <form t-if="booking.session_id.group_id.allow_self_booking and not booking.cutoff_locked"
                                                  t-attf-action="/my/physio/booking/#{booking.id}/cancel"
                                                  method="post" class="d-inline">
                                                <input type="hidden" name="csrf_token"
                                                       t-att-value="request.csrf_token()"/>
                                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                                    <i class="fa fa-times me-1"/> No puedo asistir
                                                </button>
                                            </form>
                                            <span t-if="booking.cutoff_locked" class="badge text-bg-light">
                                                <i class="fa fa-lock me-1"/> Fuera de plazo
                                            </span>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- CLASES DISPONIBLES -->
                <h4 class="mt-4 mb-3"><i class="fa fa-plus-circle me-1"/> Clases disponibles</h4>
                <div t-if="not bookable_sessions" class="text-muted mb-5">
                    No hay clases disponibles para reservar en este momento.
                </div>
                <div t-if="bookable_sessions" class="card mb-5">
                    <div class="card-body p-0">
                        <table class="table mb-0 align-middle">
                            <thead>
                                <tr>
                                    <th>Fecha y hora</th>
                                    <th>Grupo</th>
                                    <th>Plazas libres</th>
                                    <th class="text-end">Acción</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="bookable_sessions" t-as="session">
                                    <tr>
                                        <td><span t-field="session.start_datetime"/></td>
                                        <td>
                                            <span t-field="session.group_id.name"/>
                                            <span t-if="session.group_id not in memberships.mapped('group_id')"
                                                  class="badge text-bg-info ms-1">otro grupo</span>
                                        </td>
                                        <td>
                                            <span class="badge text-bg-success"
                                                  t-esc="session.seats_available"/>
                                        </td>
                                        <td class="text-end">
                                            <form t-attf-action="/my/physio/session/#{session.id}/book"
                                                  method="post" class="d-inline">
                                                <input type="hidden" name="csrf_token"
                                                       t-att-value="request.csrf_token()"/>
                                                <button type="submit" class="btn btn-sm btn-primary">
                                                    <i class="fa fa-plus me-1"/> Apuntarme
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- ==================== VISTA SEMANAL (estilo WODBUSTER) ==================== -->
    <template id="portal_physio_week" name="Portal: Planificación semanal">
        <t t-call="portal.portal_layout">
            <t t-set="page_name" t-value="'physio'"/>
            <div class="container">
                <ol class="breadcrumb mt-3 mb-0">
                    <li class="breadcrumb-item">
                        <a href="/my/home" aria-label="Inicio" title="Inicio"><i class="fa fa-home"/></a>
                    </li>
                    <li class="breadcrumb-item"><a href="/my/physio">Mis clases</a></li>
                    <li class="breadcrumb-item active">Planificación semanal</li>
                </ol>

                <div t-if="request.params.get('booking_ok')" class="alert alert-success mt-3" role="alert">
                    <i class="fa fa-check-circle me-1"/> Te has apuntado a la clase correctamente.
                </div>
                <div t-if="request.params.get('cancel_ok')" class="alert alert-info mt-3" role="alert">
                    <i class="fa fa-info-circle me-1"/> Has anulado tu reserva.
                </div>
                <div t-if="request.params.get('booking_error')" class="alert alert-danger mt-3" role="alert">
                    <i class="fa fa-exclamation-triangle me-1"/> No se ha podido completar la operación.
                </div>
                <div t-if="request.params.get('cutoff_error')" class="alert alert-warning mt-3" role="alert">
                    <i class="fa fa-clock-o me-1"/> Debes gestionar los cambios con suficiente antelación.
                </div>
                <div t-if="request.params.get('limit_error')" class="alert alert-warning mt-3" role="alert">
                    <i class="fa fa-exclamation-circle me-1"/> Has alcanzado el número máximo de clases de este mes.
                </div>

                <div class="d-flex justify-content-between align-items-center mt-4 mb-2 flex-wrap gap-2">
                    <h3 class="m-0">Planificación semanal</h3>
                    <a href="/my/physio" class="btn btn-outline-secondary btn-sm">
                        <i class="fa fa-list me-1"/> Vista lista
                    </a>
                </div>

                <!-- Navegación de semanas -->
                <div class="d-flex justify-content-between align-items-center my-3">
                    <a t-if="week &gt; -4" t-attf-href="/my/physio/semana?week=#{week - 1}"
                       class="btn btn-light"><i class="fa fa-chevron-left me-1"/> Anterior</a>
                    <span t-else="" class="btn btn-light disabled"><i class="fa fa-chevron-left me-1"/> Anterior</span>

                    <strong>
                        Semana del <span t-esc="monday.strftime('%d/%m')"/>
                        al <span t-esc="sunday.strftime('%d/%m/%Y')"/>
                    </strong>

                    <a t-if="week &lt; 8" t-attf-href="/my/physio/semana?week=#{week + 1}"
                       class="btn btn-light">Siguiente <i class="fa fa-chevron-right ms-1"/></a>
                    <span t-else="" class="btn btn-light disabled">Siguiente <i class="fa fa-chevron-right ms-1"/></span>
                </div>

                <div t-if="not memberships" class="alert alert-warning">
                    Todavía no tienes una suscripción activa. Ponte en contacto con la clínica.
                </div>

                <!-- Rejilla semanal -->
                <div class="row g-2 mb-5">
                    <t t-foreach="days" t-as="day">
                        <div class="col-12 col-md">
                            <div t-attf-class="card h-100 #{day['is_today'] and 'border-primary' or ''}">
                                <div t-attf-class="card-header py-2 text-center #{day['is_today'] and 'bg-primary-subtle' or ''}">
                                    <div class="fw-bold" t-esc="day['label']"/>
                                    <small class="text-muted" t-esc="day['date'].strftime('%d/%m')"/>
                                </div>
                                <div class="card-body p-2">
                                    <div t-if="not day['sessions']" class="text-muted small text-center py-2">—</div>
                                    <t t-foreach="day['sessions']" t-as="item">
                                        <div t-attf-class="border rounded p-2 mb-2 #{item['booking'] and 'border-success bg-success-subtle' or ''}">
                                            <div class="fw-bold" t-esc="item['time']"/>
                                            <div class="small text-muted" t-esc="item['session'].group_id.name"/>
                                            <div class="small mb-1">
                                                <span class="badge text-bg-light"><t t-esc="item['session'].seats_available"/> libres</span>
                                                <span t-if="not item['own']" class="badge text-bg-info">otro grupo</span>
                                            </div>
                                            <!-- Acción -->
                                            <t t-if="item['booking']">
                                                <span t-if="item['session']._is_within_cutoff()"
                                                      class="badge text-bg-success w-100"><i class="fa fa-check me-1"/> Apuntada</span>
                                                <form t-else="" method="post" class="m-0"
                                                      t-attf-action="/my/physio/booking/#{item['booking'].id}/cancel">
                                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                                    <input type="hidden" name="redirect" t-att-value="redirect"/>
                                                    <button type="submit" class="btn btn-sm btn-outline-danger w-100">
                                                        No puedo asistir
                                                    </button>
                                                </form>
                                            </t>
                                            <t t-elif="item['bookable']">
                                                <form method="post" class="m-0"
                                                      t-attf-action="/my/physio/session/#{item['session'].id}/book">
                                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                                    <input type="hidden" name="redirect" t-att-value="redirect"/>
                                                    <button type="submit" class="btn btn-sm btn-primary w-100">
                                                        Apuntarme
                                                    </button>
                                                </form>
                                            </t>
                                            <t t-else="">
                                                <span t-if="item['session'].seats_available &lt;= 0"
                                                      class="badge text-bg-secondary w-100">Completa</span>
                                                <span t-else="" class="badge text-bg-light w-100"><i class="fa fa-lock me-1"/> Fuera de plazo</span>
                                            </t>
                                        </div>
                                    </t>
                                </div>
                            </div>
                        </div>
                    </t>
                </div>
            </div>
        </t>
    </template>

</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- ==================== CATEGORÍA / MÓDULO ==================== -->
    <record id="module_category_physio" model="ir.module.category">
        <field name="name">Fisioterapia</field>
        <field name="description">Gestión de grupos, clases y suscripciones de fisioterapia.</field>
        <field name="sequence">20</field>
    </record>

    <!-- Privilegio (Odoo 19 agrupa los grupos de seguridad por privilegio) -->
    <record id="privilege_physio" model="res.groups.privilege">
        <field name="name">Fisioterapia</field>
        <field name="category_id" ref="module_category_physio"/>
        <field name="sequence">20</field>
    </record>

    <!-- ==================== GRUPOS DE SEGURIDAD ==================== -->
    <record id="group_physio_user" model="res.groups">
        <field name="name">Recepción</field>
        <field name="privilege_id" ref="privilege_physio"/>
        <field name="comment">Personal de recepción: gestiona pacientes, clases, reservas y cobros.</field>
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
    </record>

    <record id="group_physio_manager" model="res.groups">
        <field name="name">Responsable</field>
        <field name="privilege_id" ref="privilege_physio"/>
        <field name="implied_ids" eval="[(4, ref('group_physio_user')), (4, ref('account.group_account_invoice')), (4, ref('sales_team.group_sale_salesman'))]"/>
        <field name="comment">Responsable de la clínica: además configura grupos, precios y ajustes.</field>
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
    </record>

    <!-- ==================== REGLAS DE REGISTRO (BACKEND) ==================== -->
    <!-- Multi-compañía en grupos -->
    <record id="physio_group_company_rule" model="ir.rule">
        <field name="name">Grupos: multi-compañía</field>
        <field name="model_id" ref="model_physio_group"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>

    <record id="physio_session_company_rule" model="ir.rule">
        <field name="name">Clases: multi-compañía</field>
        <field name="model_id" ref="model_physio_session"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>

    <record id="physio_membership_company_rule" model="ir.rule">
        <field name="name">Suscripciones: multi-compañía</field>
        <field name="model_id" ref="model_physio_membership"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>

    <!-- ==================== REGLAS DE REGISTRO (PORTAL) ==================== -->
    <!-- El paciente sólo ve sus propias suscripciones -->
    <record id="physio_membership_portal_rule" model="ir.rule">
        <field name="name">Suscripciones: portal (propias)</field>
        <field name="model_id" ref="model_physio_membership"/>
        <field name="domain_force">[('partner_id', '=', user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- El paciente sólo ve sus propias reservas -->
    <record id="physio_booking_portal_rule" model="ir.rule">
        <field name="name">Reservas: portal (propias)</field>
        <field name="model_id" ref="model_physio_booking"/>
        <field name="domain_force">[('partner_id', '=', user.partner_id.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- El paciente puede leer las clases activas (para ver disponibilidad) -->
    <record id="physio_session_portal_rule" model="ir.rule">
        <field name="name">Clases: portal (visibles)</field>
        <field name="model_id" ref="model_physio_session"/>
        <field name="domain_force">[('state', '=', 'scheduled')]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- El paciente puede leer los grupos publicados -->
    <record id="physio_group_portal_rule" model="ir.rule">
        <field name="name">Grupos: portal (publicados)</field>
        <field name="model_id" ref="model_physio_group"/>
        <field name="domain_force">[('active', '=', True)]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

</odoo>

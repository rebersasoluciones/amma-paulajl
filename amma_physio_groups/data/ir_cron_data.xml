<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- Generación mensual de facturas de las suscripciones activas -->
    <record id="cron_physio_membership_invoice" model="ir.cron">
        <field name="name">Fisioterapia: facturar suscripciones vencidas</field>
        <field name="model_id" ref="model_physio_membership"/>
        <field name="state">code</field>
        <field name="code">model._cron_generate_invoices()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>

    <!-- Generación automática de las clases del próximo periodo -->
    <record id="cron_physio_session_generate" model="ir.cron">
        <field name="name">Fisioterapia: generar clases del periodo</field>
        <field name="model_id" ref="model_physio_group"/>
        <field name="state">code</field>
        <field name="code">model._cron_generate_sessions()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">weeks</field>
        <field name="active" eval="True"/>
    </record>

</odoo>

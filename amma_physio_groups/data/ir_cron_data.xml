<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- La facturación recurrente la gestiona el cron nativo de Suscripciones
         (sale.order._cron_recurring_create_invoice). -->

    <!-- Generación automática de las clases del próximo periodo -->
    <record id="cron_physio_session_generate" model="ir.cron">
        <field name="name">Fisioterapia: generar clases del periodo</field>
        <field name="model_id" ref="model_physio_group"/>
        <field name="state">code</field>
        <field name="code">model._cron_generate_sessions()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">weeks</field>
        <field name="active" eval="True"/>
    </record>

</odoo>

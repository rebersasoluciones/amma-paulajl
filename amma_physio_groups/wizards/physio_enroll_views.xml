<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_physio_enroll_wizard_form" model="ir.ui.view">
        <field name="name">physio.enroll.wizard.form</field>
        <field name="model">physio.enroll.wizard</field>
        <field name="arch" type="xml">
            <form string="Crear suscripciones">
                <sheet>
                    <div class="oe_title">
                        <h2>Alta de suscripciones</h2>
                    </div>
                    <group>
                        <group>
                            <field name="group_id" options="{'no_create': True}"/>
                            <field name="date_start"/>
                            <field name="auto_confirm"/>
                        </group>
                        <group>
                            <field name="product_id"/>
                            <field name="plan_id"/>
                            <field name="price" widget="monetary"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <field name="partner_ids" widget="many2many_tags"
                           options="{'no_quick_create': True}"
                           placeholder="Selecciona uno o varios pacientes..."/>
                    <p class="text-muted">
                        Se creará una suscripción nativa por paciente con el producto, plan y
                        cuota del grupo. Si «Confirmar» está activo, empieza la facturación y
                        el paciente queda apuntado a las clases. Se omiten los pacientes que ya
                        tengan una suscripción en este grupo.
                    </p>
                </sheet>
                <footer>
                    <button name="action_create" type="object" string="Crear suscripciones"
                            class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_physio_session_generate_form" model="ir.ui.view">
        <field name="name">physio.session.generate.form</field>
        <field name="model">physio.session.generate</field>
        <field name="arch" type="xml">
            <form string="Generar clases">
                <sheet>
                    <div class="oe_title">
                        <h2>Generar clases del grupo</h2>
                    </div>
                    <group>
                        <field name="group_id" options="{'no_create': True}"/>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                    <p class="text-muted">
                        Se crearán las clases según el horario semanal del grupo,
                        evitando duplicados con las clases ya existentes.
                    </p>
                </sheet>
                <footer>
                    <button name="action_generate" type="object" string="Generar"
                            class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>

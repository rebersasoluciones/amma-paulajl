<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Botones de cobro en la factura -->
    <record id="view_move_form_physio" model="ir.ui.view">
        <field name="name">account.move.form.physio</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_physio_payment_link" type="object"
                        string="Enlace de pago" class="btn-secondary"
                        invisible="move_type != 'out_invoice' or state != 'posted' or payment_state in ('paid', 'in_payment', 'reversed')"/>
                <button name="action_physio_send_invoice_email" type="object"
                        string="Reenviar cobro" class="btn-secondary"
                        invisible="not physio_membership_id or state != 'posted'"/>
            </xpath>
        </field>
    </record>

    <!-- Lista de cobros de fisioterapia -->
    <record id="view_physio_payment_list" model="ir.ui.view">
        <field name="name">account.move.physio.payments.list</field>
        <field name="model">account.move</field>
        <field name="arch" type="xml">
            <list string="Cobros" create="false"
                  decoration-danger="payment_state == 'not_paid' and state == 'posted'"
                  decoration-success="payment_state in ('paid', 'in_payment')">
                <field name="invoice_date"/>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="physio_group_id" string="Grupo" optional="show"/>
                <field name="amount_total" widget="monetary"/>
                <field name="amount_residual" widget="monetary" string="Pendiente"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="payment_state" widget="badge"
                       decoration-success="payment_state in ('paid', 'in_payment')"
                       decoration-warning="payment_state == 'partial'"
                       decoration-danger="payment_state == 'not_paid'"/>
                <field name="state" widget="badge" optional="hide"/>
                <button name="action_register_payment" type="object"
                        string="Registrar pago (efectivo/banco)" icon="fa-money"
                        invisible="state != 'posted' or payment_state in ('paid', 'in_payment', 'reversed')"/>
                <button name="action_physio_payment_link" type="object"
                        string="Enlace de pago" icon="fa-link"
                        invisible="state != 'posted' or payment_state in ('paid', 'in_payment', 'reversed')"/>
                <button name="action_physio_send_invoice_email" type="object"
                        string="Reenviar cobro" icon="fa-envelope"
                        invisible="state != 'posted'"/>
            </list>
        </field>
    </record>

    <record id="view_physio_payment_search" model="ir.ui.view">
        <field name="name">account.move.physio.payments.search</field>
        <field name="model">account.move</field>
        <field name="arch" type="xml">
            <search string="Cobros">
                <field name="partner_id"/>
                <field name="name"/>
                <field name="physio_group_id"/>
                <filter string="Pendientes de pago" name="not_paid"
                        domain="[('payment_state', '=', 'not_paid')]"/>
                <filter string="Pago parcial" name="partial"
                        domain="[('payment_state', '=', 'partial')]"/>
                <filter string="Pagadas" name="paid"
                        domain="[('payment_state', 'in', ('paid', 'in_payment'))]"/>
                <separator/>
                <filter string="Borrador" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Contabilizadas" name="posted" domain="[('state', '=', 'posted')]"/>
                <group expand="0" string="Agrupar por">
                    <filter string="Paciente" name="group_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Grupo" name="group_group" context="{'group_by': 'physio_group_id'}"/>
                    <filter string="Estado de pago" name="group_payment" context="{'group_by': 'payment_state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_physio_payments" model="ir.actions.act_window">
        <field name="name">Cobros</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('physio_membership_id', '!=', False), ('move_type', '=', 'out_invoice')]</field>
        <field name="context">{'search_default_posted': 1}</field>
        <field name="view_id" ref="view_physio_payment_list"/>
        <field name="search_view_id" ref="view_physio_payment_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Aquí verás los cobros de las cuotas</p>
            <p>Genera enlaces de pago al momento o registra pagos en efectivo.</p>
        </field>
    </record>

</odoo>

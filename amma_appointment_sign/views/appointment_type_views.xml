<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="appointment_type_view_form_sign" model="ir.ui.view">
        <field name="name">appointment.type.form.sign</field>
        <field name="model">appointment.type</field>
        <field name="inherit_id" ref="appointment.appointment_type_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Documentos a firmar (consulta)" name="physio_sign">
                    <field name="sign_auto_send"/>
                    <field name="sign_template_ids" widget="many2many_tags"
                           options="{'no_create': True}"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>

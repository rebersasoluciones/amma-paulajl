<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="module_category_clinical" model="ir.module.category">
            <field name="name">Historia clínica</field>
            <field name="description">Acceso a la historia clínica de los pacientes.</field>
            <field name="sequence">20</field>
        </record>

        <record id="privilege_clinical" model="res.groups.privilege">
            <field name="name">Historia clínica</field>
            <field name="category_id" ref="module_category_clinical"/>
            <field name="sequence">10</field>
        </record>

        <record id="group_clinical_user" model="res.groups">
            <field name="name">Personal clínico</field>
            <field name="privilege_id" ref="privilege_clinical"/>
            <field name="sequence">10</field>
            <field name="comment">Ve y escribe la historia clínica de los pacientes.</field>
        </record>

        <record id="group_clinical_manager" model="res.groups">
            <field name="name">Responsable</field>
            <field name="privilege_id" ref="privilege_clinical"/>
            <field name="sequence">20</field>
            <field name="implied_ids" eval="[(4, ref('group_clinical_user'))]"/>
            <field name="comment">Además configura las plantillas y puede borrar registros.</field>
        </record>

    </data>
</odoo>
